# SENTINEL-X configuration.
#
# Copy to .env and fill in. .env is gitignored; this file documents the surface
# and must never contain a real value.
#
#   cp .env.example .env
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'   # SECRET_KEY

# ---------------------------------------------------------------- general
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --------------------------------------------------------------- database
# The docker-compose stack builds this URL from the POSTGRES_* values below.
# Set DATABASE_URL directly only when running the backend outside compose.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=sentinelx
# DATABASE_URL=postgresql+psycopg://sentinel:<password>@localhost:5432/sentinelx
#
# SQLite is supported for a zero-dependency local run and for the test suite.
# Every query in the codebase is dialect-neutral and the suite runs on both.
# DATABASE_URL=sqlite+pysqlite:///./sentinelx.db

# --------------------------------------------------------------- security
# No default. In production the application refuses to start without this
# rather than signing tokens with a well-known value. In development an
# ephemeral key is generated per process, so tokens do not survive a restart.
SECRET_KEY=<generate-me>

ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_REQUEST_BYTES=4194304

# Per-caller budgets. The sign-in throttle is deliberately not configurable:
# rate-limiting credential guessing is not something a deployment should be
# able to switch off.
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# The first administrator account, created by scripts/seed_database.py only.
# Leave the password blank and the seed script generates a random one and
# prints it once. There is no default password anywhere in this project.
BOOTSTRAP_ADMIN_USERNAME=analyst
BOOTSTRAP_ADMIN_PASSWORD=

# -------------------------------------------------------------- detection
DETECTION_RULES_DIR=./detection-rules
DATA_DIR=./data
DETECTION_LOOKBACK_SECONDS=3600
CORRELATION_WINDOW_SECONDS=1800

# --------------------------------------------------------------- ai layer
# Entirely optional. SENTINEL-X detects, correlates, scores, maps to ATT&CK and
# reports with no AI provider configured; the assistant adds explanation and
# summarisation on top of results that were already computed deterministically.
#
# With AI_PROVIDER set but no key, the application downgrades to "none" and says
# so in the interface rather than failing at request time.
AI_PROVIDER=none                 # none | anthropic | openai
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=1500
AI_TIMEOUT_SECONDS=45
AI_MAX_EVIDENCE_EVENTS=60

# ------------------------------------------------------------------ demo
# Seeds a demo estate on first start. Every seeded record is flagged in the
# database and labelled SIMULATED in the interface.
DEMO_MODE=true

# --------------------------------------------------------------- compose
WEB_PORT=8080
